# Пример переменных окружения для Backend (НЕ коммитить реальные значения!).
# Скопируйте в .env и заполните:
#   cp deploy/backend/env.example deploy/backend/.env
# На хостинге с docker-compose этот файл передаётся через --env-file.

# --- PostgreSQL (используется docker-compose) ---
# Пароль БД — придумайте надёжный (НЕ "password").
POSTGRES_USER="aquamind"
POSTGRES_PASSWORD="CHANGE_ME_strong_password"
POSTGRES_DB="aquamind"

# --- Backend ---
# Адрес прослушивания (внутри контейнера; наружу публикуется 8080).
AQUAMIND_BACKEND_LISTEN=":8080"

# Строка подключения к PostgreSQL.
# В docker-compose DSN собирается автоматически из POSTGRES_* выше — эту
# переменную можно НЕ задавать. Нужна только при запуске без docker-compose
# (например, systemd + локальный PostgreSQL):
# AQUAMIND_BACKEND_POSTGRES_DSN="postgres://aquamind:password@localhost:5432/aquamind?sslmode=disable"

# --- Telegram-бот (получить токен у @BotFather, chat_id — у @userinfobot) ---
# Если не заданы — уведомления пишутся только в лог (telegram disabled).
AQUAMIND_BACKEND_TG_TOKEN=""
AQUAMIND_BACKEND_TG_CHAT_ID=""

# Антиспам: cooldown между повторными уведомлениями.
AQUAMIND_BACKEND_NOTIFY_COOLDOWN="5m"

